<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd http://www.springframework.org/schema/context https://www.springframework.org/schema/context/spring-context.xsd">

    <context:annotation-config/>

    <bean class="ru.javawebinar.topjava.repository.inmemory.InMemoryUserRepository" id="inmemoryUserRepository"/>
    <bean class="ru.javawebinar.topjava.service.UserService" id="userService">
        <constructor-arg ref="inmemoryUserRepository"/>
    </bean>
    <bean class="ru.javawebinar.topjava.web.user.AdminRestController" id="adminRestController"/>
    
    <bean class="ru.javawebinar.topjava.repository.inmemory.InMemoryMealRepository" id="inMemoryMealRepository"/>
    <bean class="ru.javawebinar.topjava.service.MealService" id="mealService">
        <constructor-arg ref="inMemoryMealRepository"/>
    </bean>
    <bean class="ru.javawebinar.topjava.web.meal.MealRestController" id="mealRestController"/>
</beans>